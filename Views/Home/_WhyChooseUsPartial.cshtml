@using System.Text.Json
@model DrivingSchoolWeb.Models.LandingPageViewModel
@{
    var apiBase = ViewBag.ApiBaseUrl ?? "http://localhost:8080";
    var settings = Model.Settings ?? new Dictionary<string, string>();
    var title = settings.ContainsKey("wcu_title") ? settings["wcu_title"] : "Vì Sao Hơn 5,000+ Học Viên Chọn Chúng Tôi?";
    
    // Đọc danh sách các đoạn mô tả ngắn từ key wcu_descriptions
    var descsJson = settings.ContainsKey("wcu_descriptions") ? settings["wcu_descriptions"] : "[]";
    List<string> descs = new List<string>();
    try {
        descs = JsonSerializer.Deserialize<List<string>>(descsJson);
    } catch { }

    // Tương thích ngược: Nếu chưa có wcu_descriptions thì lấy từ wcu_description
    if (descs == null || !descs.Any())
    {
        descs = new List<string>();
        var d = settings.ContainsKey("wcu_description") ? settings["wcu_description"] : "";
        if (!string.IsNullOrEmpty(d)) descs.Add(d);
    }

    // Nếu vẫn rỗng hoàn toàn, dùng nội dung mặc định ban đầu
    if (!descs.Any())
    {
        descs.Add("Với triết lý giáo dục đặt sự an toàn và kỹ năng thực tế lên hàng đầu, chúng tôi mang đến môi trường học tập chuyên nghiệp.");
    }

    var imgPath = settings.ContainsKey("wcu_image") ? settings["wcu_image"] : "";
    var wcuImg = string.IsNullOrEmpty(imgPath) ? "/img/default_wcu.jpg" : $"{apiBase}{imgPath}";

    var statsJson = settings.ContainsKey("wcu_stats") ? settings["wcu_stats"] : "[]";
    List<dynamic> stats = new List<dynamic>();
    try {
        stats = JsonSerializer.Deserialize<List<dynamic>>(statsJson);
    } catch { }

    var featuresJson = settings.ContainsKey("wcu_features") ? settings["wcu_features"] : "[]";
    List<dynamic> features = new List<dynamic>();
    try {
        features = JsonSerializer.Deserialize<List<dynamic>>(featuresJson);
    } catch { }
}

<section class="py-4 bg-surface overflow-hidden relative" id="why-us">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <!-- Phần trên: Text, Stats và Ảnh -->
        <div class="flex flex-col lg:flex-row gap-12 items-center mb-16">
            <!-- Cột trái: Text -->
            <div class="lg:w-1/2" data-aos="fade-right">
                <h2 class="text-4xl md:text-5xl font-black text-on-surface mb-6" style="line-height: 1.45 !important;">
                    @Html.Raw(title.Replace("5,000+", "<span class=\"text-primary\">5,000+</span>"))
                </h2>
                <div class="w-16 h-1.5 bg-primary mb-6 rounded-full"></div>
                
                @foreach (var descText in descs)
                {
                    <p class="text-lg text-on-surface-variant mb-4 leading-relaxed">
                        @descText
                    </p>
                }
            </div>
            
            <!-- Cột phải: Carousel ảnh -->
            <div class="lg:w-1/2 w-full" data-aos="fade-left">
                <div class="relative rounded-2xl overflow-hidden shadow-xl border border-gray-200 p-2 bg-white">
                    <div class="wcu-carousel rounded-xl overflow-hidden relative" style="aspect-ratio: 16/10;">
                        @{
                            var carouselImages = new List<string>();
                            // Thêm ảnh từ bảng wcu_images riêng
                            if (Model.WcuImages != null)
                            {
                                foreach (var wcuItem in Model.WcuImages)
                                {
                                    var wcuItemImg = !string.IsNullOrEmpty(wcuItem.Image_url) ? $"{apiBase}{wcuItem.Image_url}" : "";
                                    if (!string.IsNullOrEmpty(wcuItemImg)) { carouselImages.Add(wcuItemImg); }
                                }
                            }
                            // Nếu không có ảnh nào thì dùng default
                            if (carouselImages.Count == 0) { carouselImages.Add("/img/default_wcu.jpg"); }
                        }
                        @for (int i = 0; i < carouselImages.Count; i++)
                        {
                            <img class="wcu-slide @(i == 0 ? "active" : "")" 
                                 src="@carouselImages[i]" 
                                 alt="Vì sao chọn chúng tôi - @(i+1)" 
                                 loading="lazy"
                                 style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: @(i == 0 ? "1" : "0"); transition: opacity 0.8s ease;" />
                        }
                        <!-- Nút điều hướng -->
                        @if (carouselImages.Count > 1)
                        {
                            <button class="wcu-prev" onclick="wcuSlide(-1)" aria-label="Trước">
                                <span class="material-symbols-outlined">chevron_left</span>
                            </button>
                            <button class="wcu-next" onclick="wcuSlide(1)" aria-label="Sau">
                                <span class="material-symbols-outlined">chevron_right</span>
                            </button>
                            <!-- Dots -->
                            <div class="wcu-dots">
                                @for (int i = 0; i < carouselImages.Count; i++)
                                {
                                    <span class="wcu-dot @(i == 0 ? "active" : "")" onclick="wcuGoto(@i)"></span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Khối Stats căn giữa theo hàng ngang -->
        @if (stats.Count > 0)
        {
            <div class="flex justify-center mb-16" data-aos="fade-up">
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 w-full max-w-3xl">
                    @{
                        var statIndex = 0;
                        foreach (var statObj in stats)
                        {
                            var stat = JsonSerializer.Deserialize<Dictionary<string, string>>(statObj.ToString());
                            if (stat != null)
                            {
                                bool isHighlight = statIndex == 1;
                                
                                <div class="p-5 rounded-2xl shadow-md flex flex-col items-center justify-center text-center border transition-all duration-300 hover:shadow-lg @(isHighlight ? "bg-primary text-white border-primary" : "bg-white text-on-surface border-gray-200")">
                                    <span class="text-3xl lg:text-4xl font-black mb-1.5 @(isHighlight ? "text-white" : "text-primary")">@stat["value"]</span>
                                    <span class="text-xs font-bold uppercase tracking-wider @(isHighlight ? "text-blue-100" : "text-on-surface-variant")">@stat["label"]</span>
                                </div>
                            }
                            
                            statIndex++;
                        }
                    }
                </div>
            </div>
        }

        <!-- Phần dưới: Thẻ tính năng -->
        @if (features.Count > 4)
        {
            <!-- Carousel Container -->
            <div class="relative overflow-hidden w-full px-[10%] sm:px-[8%] feature-carousel-wrapper">
                <!-- Carousel Track -->
                <div id="feature-carousel" class="flex gap-4 w-full" style="transform: translateX(0);">
                    @foreach (var featureObj in features)
                    {
                        var feature = JsonSerializer.Deserialize<Dictionary<string, string>>(featureObj.ToString());
                        @if (feature != null)
                        {
                            <div class="flex-shrink-0 w-full sm:w-[calc(50%-8px)] lg:w-[calc(25%-12px)] feature-slide flex justify-center" data-index="@features.IndexOf(featureObj)">
                                <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm hover:-translate-y-2 hover:shadow-lg transition-all duration-300 w-full min-h-[220px]">
                                    <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-6">
                                        <span class="material-symbols-outlined text-primary text-2xl">@feature["icon"]</span>
                                    </div>
                                    <h4 class="text-xl font-bold text-on-surface mb-3">@feature["title"]</h4>
                                    <p class="text-on-surface-variant text-sm leading-relaxed line-clamp-3">
                                        @feature["desc"]
                                    </p>
                                </div>
                            </div>
                        }
                    }
                </div>
                <!-- Navigation Indicator Dots -->
                <div class="feature-carousel-dots" id="feature-dots" data-aos="fade-up"></div>
            </div>
        }
        else
        {
            <!-- Hiển thị tĩnh khi item < 4 -->
            <div class="flex flex-wrap justify-center gap-6" data-aos="fade-up">
                @foreach (var featureObj in features)
                {
                    var feature = JsonSerializer.Deserialize<Dictionary<string, string>>(featureObj.ToString());
                    @if (feature != null)
                    {
                        <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm hover:-translate-y-2 hover:shadow-lg transition-all duration-300 w-full sm:w-[calc(50%-12px)] lg:w-[calc(25%-18px)]">
                            <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-6">
                                <span class="material-symbols-outlined text-primary text-2xl">@feature["icon"]</span>
                            </div>
                            <h4 class="text-xl font-bold text-on-surface mb-3">@feature["title"]</h4>
                            <p class="text-on-surface-variant text-sm leading-relaxed">
                                @feature["desc"]
                            </p>
                        </div>
                    }
                }
            </div>
        }
    </div>
</section>

@if (features.Count > 4)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const carousel = document.getElementById("feature-carousel");
            const dotsContainer = document.getElementById("feature-dots");
            if (!carousel || !dotsContainer) return;

            let items = Array.from(carousel.querySelectorAll(".feature-slide"));
            const total = items.length;
            if (total === 0) return;

            let currentIndex = 0;
            let autoplayInterval;
            const autoplayDelay = 5000;
            let isTransitioning = false;

            const gap = 16;
            let slideWidth = items[0].offsetWidth;
            let moveAmount = slideWidth + gap;

            const lastItem = items[total - 1];
            carousel.insertBefore(lastItem, items[0]);

            carousel.style.transition = "none";
            carousel.style.transform = `translateX(-${moveAmount}px)`;

            for (let i = 0; i < total; i++) {
                const dot = document.createElement("button");
                dot.className = "feature-dot" + (i === 0 ? " active" : "");
                dot.setAttribute("aria-label", "Feature " + (i + 1));
                dot.dataset.index = i;
                dot.addEventListener("click", function () {
                    if (isTransitioning) return;
                    goToFeature(i);
                });
                dotsContainer.appendChild(dot);
            }

            const dots = dotsContainer.querySelectorAll(".feature-dot");

            function setActiveDot(index) {
                dots.forEach((d) => {
                    d.classList.toggle("active", parseInt(d.dataset.index) === index);
                });
            }

            function slideNext() {
                if (isTransitioning) return;
                isTransitioning = true;

                slideWidth = carousel.firstElementChild.offsetWidth;
                moveAmount = slideWidth + gap;

                carousel.style.transition = "transform 0.5s ease-out";
                carousel.style.transform = `translateX(-${moveAmount * 2}px)`;

                setTimeout(function () {
                    carousel.style.transition = "none";
                    const firstCurrent = carousel.firstElementChild;
                    carousel.appendChild(firstCurrent);
                    carousel.style.transform = `translateX(-${moveAmount}px)`;

                    const activeSlide = carousel.children[1];
                    if (activeSlide) {
                        currentIndex = parseInt(activeSlide.dataset.index);
                        setActiveDot(currentIndex);
                    }

                    isTransitioning = false;
                }, 500);
            }

            function slidePrev() {
                if (isTransitioning) return;
                isTransitioning = true;

                slideWidth = carousel.firstElementChild.offsetWidth;
                moveAmount = slideWidth + gap;

                carousel.style.transition = "transform 0.5s ease-out";
                carousel.style.transform = "translateX(0)";

                setTimeout(function () {
                    carousel.style.transition = "none";
                    const lastCurrent = carousel.lastElementChild;
                    carousel.insertBefore(lastCurrent, carousel.firstElementChild);
                    carousel.style.transform = `translateX(-${moveAmount}px)`;

                    const activeSlide = carousel.children[1];
                    if (activeSlide) {
                        currentIndex = parseInt(activeSlide.dataset.index);
                        setActiveDot(currentIndex);
                    }
                    isTransitioning = false;
                }, 500);
            }

            function goToFeature(targetIndex) {
                if (currentIndex === targetIndex || isTransitioning) return;
                isTransitioning = true;

                slideWidth = carousel.firstElementChild.offsetWidth;
                moveAmount = slideWidth + gap;

                const currentItems = Array.from(carousel.children);
                const targetSlide = currentItems.find(item => parseInt(item.dataset.index) === targetIndex);
                if (!targetSlide) {
                    isTransitioning = false;
                    return;
                }

                const targetPos = currentItems.indexOf(targetSlide);

                if (targetPos > 1) {
                    const distance = moveAmount * (targetPos - 1);
                    carousel.style.transition = "transform 0.5s ease-out";
                    carousel.style.transform = `translateX(-${moveAmount + distance}px)`;

                    setTimeout(function () {
                        carousel.style.transition = "none";
                        for (let i = 0; i < targetPos - 1; i++) {
                            carousel.appendChild(currentItems[i]);
                        }
                        carousel.style.transform = `translateX(-${moveAmount}px)`;

                        currentIndex = targetIndex;
                        setActiveDot(currentIndex);
                        isTransitioning = false;
                    }, 500);
                } else if (targetPos === 0) {
                    carousel.style.transition = "transform 0.5s ease-out";
                    carousel.style.transform = "translateX(0)";

                    setTimeout(function () {
                        carousel.style.transition = "none";
                        const lastCurrent = carousel.lastElementChild;
                        carousel.insertBefore(lastCurrent, carousel.firstElementChild);
                        carousel.style.transform = `translateX(-${moveAmount}px)`;

                        currentIndex = targetIndex;
                        setActiveDot(currentIndex);
                        isTransitioning = false;
                    }, 500);
                } else {
                    isTransitioning = false;
                }
                resetAutoplay();
            }

            function startAutoplay() {
                clearInterval(autoplayInterval);
                autoplayInterval = setInterval(slideNext, autoplayDelay);
            }

            function resetAutoplay() {
                startAutoplay();
            }

            const wrapper = carousel.parentElement;

            let isDragging = false;
            let startX = 0;
            let dragMoveAmount = 0;

            wrapper.addEventListener("mousedown", function (e) {
                if (isTransitioning) return;
                if (e.button !== 0) return;

                isDragging = true;
                startX = e.clientX;
                clearInterval(autoplayInterval);

                carousel.style.transition = "none";
                wrapper.classList.add("dragging");
            });

            window.addEventListener("mousemove", function (e) {
                if (!isDragging) return;

                const currentX = e.clientX;
                dragMoveAmount = currentX - startX;

                const translateValue = -moveAmount + dragMoveAmount;
                carousel.style.transform = `translateX(${translateValue}px)`;
            });

            function endDrag() {
                if (!isDragging) return;
                isDragging = false;
                wrapper.classList.remove("dragging");

                carousel.style.transition = "transform 0.5s ease-out";

                if (Math.abs(dragMoveAmount) > 60) {
                    if (dragMoveAmount < 0) {
                        slideNext();
                    } else {
                        slidePrev();
                    }
                } else {
                    carousel.style.transform = `translateX(-${moveAmount}px)`;
                    if (total > (window.innerWidth < 640 ? 1 : (window.innerWidth < 1024 ? 2 : 4))) {
                        startAutoplay();
                    }
                }
                dragMoveAmount = 0;
            }

            window.addEventListener("mouseup", endDrag);

            const isMobile = window.innerWidth < 640;
            const isTablet = window.innerWidth < 1024;
            const visibleCount = isMobile ? 1 : (isTablet ? 2 : 4);

            if (total > visibleCount) {
                startAutoplay();

                wrapper.addEventListener("mouseenter", function () {
                    clearInterval(autoplayInterval);
                });

                wrapper.addEventListener("mouseleave", function () {
                    if (!isDragging) {
                        startAutoplay();
                    }
                });

                // Touch Drag support
                let touchStartX = 0;
                let touchMoveAmount = 0;
                let isTouching = false;

                wrapper.addEventListener("touchstart", function (e) {
                    if (isTransitioning) return;
                    isTouching = true;
                    clearInterval(autoplayInterval);
                    touchStartX = e.touches[0].clientX;
                    carousel.style.transition = "none";
                }, { passive: true });

                wrapper.addEventListener("touchmove", function (e) {
                    if (!isTouching) return;
                    const currentX = e.touches[0].clientX;
                    touchMoveAmount = currentX - touchStartX;

                    const translateValue = -moveAmount + touchMoveAmount;
                    carousel.style.transform = `translateX(${translateValue}px)`;
                }, { passive: true });

                wrapper.addEventListener("touchend", function (e) {
                    if (!isTouching) return;
                    isTouching = false;

                    carousel.style.transition = "transform 0.5s ease-out";

                    if (Math.abs(touchMoveAmount) > 60) {
                        if (touchMoveAmount < 0) {
                            slideNext();
                        } else {
                            slidePrev();
                        }
                    } else {
                        carousel.style.transform = `translateX(-${moveAmount}px)`;
                        startAutoplay();
                    }
                    touchMoveAmount = 0;
                }, { passive: true });
            }

            window.addEventListener("resize", function () {
                slideWidth = carousel.firstElementChild.offsetWidth;
                moveAmount = slideWidth + gap;
                carousel.style.transition = "none";
                carousel.style.transform = `translateX(-${moveAmount}px)`;
            });
        });
    </script>
}