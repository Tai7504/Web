@model DrivingSchoolWeb.Models.LandingPageViewModel
@{
    var domain = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var rawHost = Context.Request.Host.Host;
    var isIpOrLocal = rawHost.Equals("localhost", StringComparison.OrdinalIgnoreCase) 
                      || rawHost.Equals("127.0.0.1") 
                      || System.Net.IPAddress.TryParse(rawHost, out _);
    var displayDomain = isIpOrLocal ? "DaoTaoLaiXeHiepThanh.vn" : rawHost;
        
    var siteTitle = "Đào Tạo Lái Xe Hiệp Thanh";
    if (!isIpOrLocal && !displayDomain.Contains("hiepthanh", StringComparison.OrdinalIgnoreCase))
    {
        var mainDomain = displayDomain.Split('.')[0];
        siteTitle = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(mainDomain.Replace("-", " ").Replace("_", " "));
    }

    ViewData["Title"] = $"{siteTitle.ToUpper()} | Đào Tạo Lái Xe Bình Dương";
    ViewData["MetaDescription"] = $"Đăng ký học lái xe ô tô B1, B2, C1, xe máy A1 tại {siteTitle}. Cam kết tỉ lệ đậu cao, học phí trọn gói không phát sinh, thời gian học linh hoạt, xe thực hành đời mới.";
    ViewData["MetaKeywords"] = $"học lái xe ô tô, học bằng B1, học bằng B2, học bằng C1, học lái xe Bình Dương, trung tâm đào tạo lái xe, {siteTitle}, thi bằng lái xe máy A1";
    ViewData["CanonicalUrl"] = domain + "/"; 
    ViewData["OgImage"] = domain + "/img/favicon.jpg"; 
    
    var address = Model.Settings.GetValueOrDefault("address", "Bình Dương");
    var phone = Model.Settings.GetValueOrDefault("hotline", "0909123456");
}

@section SEO {
    <!-- JSON-LD Structured Data for Local Business -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "DrivingSchool",
      "name": "@siteTitle",
      "image": "@(domain)/img/favicon.jpg",
      "@@id": "@(domain)/",
      "url": "@(domain)/",
      "telephone": "@phone", 
      "address": {
        "@@type": "PostalAddress",
        "streetAddress": "@address",
        "addressLocality": "Bình Dương",
        "addressRegion": "BD",
        "postalCode": "75000",
        "addressCountry": "VN"
      },
      "geo": {
        "@@type": "GeoCoordinates",
        "latitude": 11.0, 
        "longitude": 106.6
      },
      "priceRange": "VND"
    }
    </script>
}

<!-- Navigation -->
@await Html.PartialAsync("_NavPartial", Model)

<!-- Hero Section -->
@await Html.PartialAsync("_HeroPartial", Model)


<!-- 0. Danh sách Voucher ưu đãi -->
@await Html.PartialAsync("_VouchersPartial", Model)

<!-- 1. Danh sách khóa học -->
@await Html.PartialAsync("_CoursesPartial", Model)

<!-- 2. Quy trình học tập -->
@await Html.PartialAsync("_ProcessPartial", Model)

<!-- 3. Giảng viên -->
@await Html.PartialAsync("_TeachersPartial", Model)

<!-- 4. Về chúng tôi -->
@await Html.PartialAsync("_AboutPartial", Model)

<!-- 5. Vì sao chọn chúng tôi -->
@await Html.PartialAsync("_WhyChooseUsPartial", Model)

<!-- 6. Tin tức -->
@await Html.PartialAsync("_NewsPartial", Model)

<!-- 7. Footer -->
@await Html.PartialAsync("_FooterPartial", Model)
